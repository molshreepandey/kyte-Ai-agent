# Required: get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Chat / tool-calling model (any OpenRouter model that supports tools).
# Comma-separated fallback list, tried in order. Default: openai/gpt-4o-mini (paid, cheap).
# Free models work but are rate-limited, e.g.:
#   LLM_MODEL=poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free
LLM_MODEL=openai/gpt-4o-mini

# Speech-to-text mode:
#   "browser"    (default, free) - Chrome/Edge Web Speech API, STT_MODEL is ignored
#   "openrouter" - audio-capable OpenRouter model given by STT_MODEL (needs >= $0.50 credit)
STT_MODE=browser
STT_MODEL=google/gemini-2.5-flash

# Embeddings for RAG. If the call fails the app falls back to a local hashing embedder.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Persona: the business the assistant represents. Defaults match the fictional sample
# knowledge base in knowledge_base/. Change these when you replace the documents.
COMPANY_NAME=Demo Wallet
COMPANY_DESCRIPTION=a digital money-management app
KB_TOPICS=plans, fees, limits, cards, savings, bills, support, security and how-tos
# AGENT_NAME=Ava

# --- Security ---------------------------------------------------------------
# "production" disables /docs and enables HSTS.
ENVIRONMENT=development
# Enables /admin/* (header X-Admin-Key). Leave empty to disable. Use 32+ random chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# MCP tools the LLM may call. Review every tool before adding it here.
MCP_TOOL_ALLOWLIST=get_current_time,calculate,get_weather
TOOL_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=30
MAX_TEXT_CHARS=2000
MAX_AUDIO_BYTES=2000000
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# json | text (default: text in development, json in production)
LOG_FORMAT=
# Optional rotating log file, e.g. logs/app.log (default: stdout only)
LOG_FILE=
# Logs user transcripts and tool arguments. Debugging only.
LOG_TRANSCRIPTS=false

# Optional
HOST=127.0.0.1
PORT=8000
